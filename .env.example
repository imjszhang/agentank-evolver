AGENTANK_BASE_URL=https://agentank.ai
AGENTANK_TANK_KEY=

# Publishing is disabled unless this is explicitly set to true.
AGENTANK_ALLOW_PUBLISH=false

# Set true only when you intentionally want POST /api/agent/tank/challenge (ranked real match).
AGENTANK_ALLOW_CHALLENGE=false

# challenge-request writes a local approval stub only; challenge calls the remote API when allowed.
AGENTANK_SUBMITTED_BY=Cursor
